package groth16

import "testing"

// A real Groth16 proof generated by snarkjs from the same circuit and key.
// If this passes, the Gno verifier agrees with snarkjs byte for byte, including
// the BN254 point encoding the precompiles expect.
func TestVerifyAcceptsRealProof(t *testing.T) {
	if !Verify(testProofA, testProofB, testProofC, testPublicSignals) {
		t.Fatal("verifier rejected a valid snarkjs proof")
	}
}

func TestVerifyRejectsTamperedVote(t *testing.T) {
	signals := copySignals(testPublicSignals)
	signals[0] = fieldInt(7) // voter claimed a different option
	if Verify(testProofA, testProofB, testProofC, signals) {
		t.Fatal("verifier accepted a proof for a different vote")
	}
}

func TestVerifyRejectsTamperedRoot(t *testing.T) {
	signals := copySignals(testPublicSignals)
	signals[2] = fieldInt(12345)
	if Verify(testProofA, testProofB, testProofC, signals) {
		t.Fatal("verifier accepted a proof for a different member set")
	}
}

func TestVerifyRejectsTamperedNullifier(t *testing.T) {
	signals := copySignals(testPublicSignals)
	signals[3] = fieldInt(999)
	if Verify(testProofA, testProofB, testProofC, signals) {
		t.Fatal("verifier accepted a proof with a swapped nullifier")
	}
}

func TestVerifyRejectsSwappedProofPoints(t *testing.T) {
	if Verify(testProofC, testProofB, testProofA, testPublicSignals) {
		t.Fatal("verifier accepted A and C swapped")
	}
}

func TestVerifyRejectsBadLengths(t *testing.T) {
	if Verify(testProofA[:63], testProofB, testProofC, testPublicSignals) {
		t.Fatal("accepted a short proof")
	}
	if Verify(testProofA, testProofB, testProofC, testPublicSignals[:3]) {
		t.Fatal("accepted the wrong number of public signals")
	}
	bad := copySignals(testPublicSignals)
	bad[1] = bad[1][:31]
	if Verify(testProofA, testProofB, testProofC, bad) {
		t.Fatal("accepted a short public signal")
	}
}

func TestNegateG1(t *testing.T) {
	neg := negateG1(testProofA)
	if neg == nil {
		t.Fatal("negate returned nil")
	}
	if string(neg[:32]) != string(testProofA[:32]) {
		t.Fatal("negation changed x")
	}
	if string(neg[32:]) == string(testProofA[32:]) {
		t.Fatal("negation did not change y")
	}
	// P + (-P) is the point at infinity, encoded as all zeroes.
	sum := g1add(testProofA, neg)
	if sum == nil {
		t.Fatal("no result from adding P and -P")
	}
	for i := 0; i < len(sum); i++ {
		if sum[i] != 0 {
			t.Fatal("P + (-P) is not the identity")
		}
	}
}

func copySignals(in [][]byte) [][]byte {
	out := make([][]byte, len(in))
	for i := range in {
		out[i] = append([]byte(nil), in[i]...)
	}
	return out
}

func fieldInt(v int) []byte {
	out := make([]byte, 32)
	out[31] = byte(v)
	return out
}
